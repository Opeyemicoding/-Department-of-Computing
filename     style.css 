body {
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 0;
    background-color: #f4f7fb;
    color: #333;
}

header {
    background-color: #123456;
    color: white;
    text-align: center;
    padding: 30px;
}

h1 {
    margin-bottom: 10px;
}

h2 {
    color: #123456;
}

main {
    padding: 20px;
}

p {
    line-height: 1.6;
}

nav {
    background-color: #222;
    padding: 15px;
    text-align: center;
}

nav a {
    color: white;
    text-decoration: none;
    margin: 15px;
}

nav a:hover {
    color: orange;
}

footer {
    background-color: #123456;
    color: white;
    text-align: center;
    padding: 15px;
}

button {
    background-color: #123456;
    color: white;
    padding: 10px 20px;
    border: none;
    cursor: pointer;
}